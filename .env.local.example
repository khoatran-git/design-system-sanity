# Sanity Studio - Local Environment Configuration
# Copy this file to .env.local and fill in your values

# Your Sanity project ID (from https://manage.sanity.io)
SANITY_STUDIO_PROJECT_ID=q8ijpuq2

# Your Sanity dataset name
SANITY_STUDIO_DATASET=production

# Optional: Studio URL for debugging
SANITY_STUDIO_URL=https://q8ijpuq2.sanity.studio

# Optional: Enable debug logging
# SANITY_STUDIO_DEBUG=true
